{
  // TypeScript settings for the frontend unit tests. Kept next to the tests so that editors find them;
  // referenced from src/frontend/tsconfig.json, so `npm run type-check` covers the tests as well.
  "extends": "../../src/frontend/tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  "include": ["./**/*", "../../src/frontend/env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly.
    "lib": [],
    "types": ["node", "jsdom"],

    // This directory has no node_modules of its own; resolve packages and types from the frontend project.
    "typeRoots": ["../../src/frontend/node_modules/@types"],
    "paths": {
      "@/*": ["../../src/frontend/src/*"],
      "*": ["../../src/frontend/node_modules/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the repository.
    "tsBuildInfoFile": "../../src/frontend/node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
