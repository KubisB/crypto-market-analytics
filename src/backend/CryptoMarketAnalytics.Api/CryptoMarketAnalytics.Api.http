@CryptoMarketAnalytics.Api_HostAddress = https://localhost:7134

GET {{CryptoMarketAnalytics.Api_HostAddress}}/api/health

###

# What data is stored and how fresh it is
GET {{CryptoMarketAnalytics.Api_HostAddress}}/api/data-status
Accept: application/json

###

# Closed daily candles and missing days (symbols: BNBUSDT, BTCUSDT; dates are UTC days, inclusive; 'to' at most yesterday)
GET {{CryptoMarketAnalytics.Api_HostAddress}}/api/candles?symbol=BNBUSDT&from=2026-10-01&to=2026-10-31
Accept: application/json

