{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Market": {
    "Symbols": [ "BNBUSDT", "BTCUSDT" ],
    "AnalysisStartDate": "2023-01-01",
    "WarmupDays": 200,
    "LargePriceChangeThreshold": 0.5
  },
  "Binance": {
    "BaseUrl": "https://data-api.binance.vision",
    "FallbackBaseUrl": "https://api.binance.com",
    "Timeout": "00:00:30",
    "UserAgent": "CryptoMarketAnalytics/1.0"
  },
  "Storage": {
    "DatabasePath": "../../../data-base/market.db"
  },
  "Synchronization": {
    "Enabled": true,
    "CheckInterval": "00:15:00"
  }
}
