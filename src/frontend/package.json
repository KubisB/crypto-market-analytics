{
  "name": "crypto-market-analytics-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "cd ../.. && oxlint -c src/frontend/.oxlintrc.json --fix src/frontend tests/frontend",
    "lint:eslint": "cd ../.. && eslint -c src/frontend/eslint.config.ts --fix --cache --cache-location src/frontend/.eslintcache src/frontend tests/frontend",
    "format": "cd ../.. && prettier --write --experimental-cli src/frontend/src tests/frontend",
    "check:lint": "cd ../.. && oxlint -c src/frontend/.oxlintrc.json --deny-warnings src/frontend tests/frontend && eslint -c src/frontend/eslint.config.ts --max-warnings 0 src/frontend tests/frontend",
    "check:format": "cd ../.. && prettier --check --experimental-cli src/frontend/src tests/frontend"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "lightweight-charts": "^5.3.0",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
